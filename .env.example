# Copie para .env (que está no .gitignore) e ajuste:  cp .env.example .env
# Nenhum valor real de produção entra no repositório: em produção as variáveis vêm do
# painel do Render (DB_*) e do GitHub Secrets (RENDER_DEPLOY_HOOK_URL).

# --- Banco (usado pelo serviço "banco" e repassado à API como DB_*) ---
POSTGRES_DB=agendasaude
POSTGRES_USER=agendasaude
POSTGRES_PASSWORD=troque-esta-senha-local

# --- API ---
API_PORT=8080
# Opcional: versão exibida em /api/versao no ambiente local
GIT_SHA=local

# --- Variáveis que a aplicação lê (referência; o compose já monta a partir das de cima) ---
# DB_HOST=banco
# DB_PORT=5432
# DB_NAME=agendasaude
# DB_USER=agendasaude
# DB_PASSWORD=...
# PORT=8080                  # o Render define sozinho
# APP_VERSION=<sha>          # a esteira grava na imagem
